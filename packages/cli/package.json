{
  "name": "stemmory",
  "version": "0.1.2",
  "description": "Stemmory Conventions Kit CLI — installs the conventions skill and AGENTS.md fragment, and lints feature docs against the shared schema.",
  "license": "MIT",
  "author": "AdyriX Systems Private Limited",
  "keywords": [
    "cli",
    "documentation",
    "docs-as-code",
    "linter",
    "frontmatter",
    "markdown",
    "conventions",
    "ai-agents",
    "agents-md",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stemmory/cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/stemmory/cli/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/stemmory/cli/issues"
  },
  "type": "module",
  "bin": {
    "stemmory": "bin/stemmory.js"
  },
  "files": [
    "bin/stemmory.js",
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@stemmory/schema": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
