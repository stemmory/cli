{
  "name": "stemmory-cli-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r run typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r run test",
    "schema:parity": "node scripts/check-schema-parity.mjs",
    "schema:parity:update": "node scripts/generate-schema-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0"
  }
}
